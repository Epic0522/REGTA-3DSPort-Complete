# Locally prepared game-data overlays. These may contain commercial or derived
# assets and must never be published with the source repository.
/III/gamefiles/
/miami/gamefiles/
/stories/gamefiles/

# Published runtime overrides and finished HOME artwork: exact allow-list.
/gamefiles/**
!/gamefiles/**/
!/gamefiles/README.md
!/gamefiles/re3/TEXT/american.gxt
!/gamefiles/re3/audio/music/PUSH_FM.WAV
!/gamefiles/re3/audio/music/PUSH_LOOP.WAV
