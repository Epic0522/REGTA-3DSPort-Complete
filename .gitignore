!/gamefiles/relcs/AUDIO/MUSIC/CHASE_LOOP.WAV
!/gamefiles/relcs/movies/GTAtitles.3mv
!/gamefiles/relcs/movies/GTAtitles.pcm
!/gamefiles/relcs/movies/Logo.3mv
!/gamefiles/relcs/movies/Logo.pcm
