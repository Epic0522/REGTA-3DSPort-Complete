# The historical projects keep their hand-written GNUmakefiles inside build/.
# Generated objects and outputs within these directories remain ignored.
!/III/build/
!/III/build/GNUmakefile
!/III/build/shlist.sh
!/miami/build/
!/miami/build/GNUmakefile
!/miami/build/shlist.sh
