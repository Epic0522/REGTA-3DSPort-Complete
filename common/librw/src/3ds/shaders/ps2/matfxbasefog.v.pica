;; Optional PS2 distance-fog variant; keep body aligned with matfxbase.v.pica.
	;; Lightweight texture/material path for 3DS MatFX vehicles and CPU-skinned
	;; actors.  These TEV combiners ignore PRIMARY_COLOR.rgb, so calculate only
	;; the material/vertex alpha which they still consume.

	;; Inputs
.alias in_pos     v0
.alias in_color   v2
.alias in_tex0    v3

	;; Outputs
.out v_pos      position
.out v_color    color
.out v_tex0     texcoord0
.out v_fog texcoord2

.entry matfxbasefog_main
.proc matfxbasefog_main
	call	xform_vertex
	mov	v_pos, r0
	; Clamp in the sampler, after interpolation; large building faces must
	; keep their nearby portion clear even when distant vertices are in fog.
	mov	r2, u_ps2FogParams
	mad	r2.x, r0.w, u_ps2FogParams.x, r2.y
	mov	r2.y, u_ps2FogParams.z
	mov	r2.zw, zeros
	mov	v_fog, r2

	mov	r0, ones
	mul	r0.a, fixclr.a, in_color.a
	mul	r0.a, u_matColor.a, r0.a
	mov	v_color, r0
	mov	v_tex0, in_tex0

	end
.end
