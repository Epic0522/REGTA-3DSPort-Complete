;; Optional PS2 distance-fog variant; keep body aligned with matfx.v.pica.
	;; Inputs
.alias in_pos     v0
.alias in_normal  v1
.alias in_color   v2
.alias in_tex0    v3

	;; Outputs
.out v_pos      position
.out v_color	color
.out v_tex0	texcoord0
.out v_fog texcoord2
.out v_tex1	texcoord1


.constf reflWeight (0.35, 0.65, 0.0, 0.0)

.entry matfxfog_main
.proc matfxfog_main
	call	xform_vertex
	mov	v_pos, r0
	; Clamp in the sampler, after interpolation; large building faces must
	; keep their nearby portion clear even when distant vertices are in fog.
	mov	r2, u_ps2FogParams
	mad	r2.x, r0.w, u_ps2FogParams.x, r2.y
	mov	r2.y, u_ps2FogParams.z
	mov	r2.zw, zeros
	mov	v_fog, r2
	call	xform_normal	; (r9 = world-space normal)
	; The LCS 3DS MatFX pass is restricted to fully opaque paint.  Its TEV
	; stages deliberately ignore primary RGB, so running the complete dynamic
	; light loop here wastes vertex time and can reintroduce the unstable
	; per-vertex colour path.
	; Preserve material/vertex alpha even when a pane was not classified as
	; transparent by the model's material flags.
	mov	r0, ones
	mul	r0.a, fixclr.a, in_color.a
	mul	r0.a, u_matColor.a, r0.a
	; Upward-facing body panels take most of the reflection. Vertical sides keep
	; a faint contribution for signs and shop colours without repainting the car.
	max	r1.x, r9.z, -r9.z
	mul	r0.rgb, reflWeight.yyy, r1.xxx
	add	r0.rgb, reflWeight.xxx, r0.rgb
	mov	v_color, r0
	
	mov	r9.w, ones
	dp4	r0.x, u_texMatrix[0], r9
	dp4	r0.y, u_texMatrix[1], r9
	mov	v_tex0, in_tex0
	mov	v_tex1, r0

	end
.end
